<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>lazer-preview</AssemblyName>
    <RootNamespace>LazerPreview</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>NU1902;NU1903</NoWarn>
    <DebugType>none</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=/src/lazer-preview</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ppy.osu.Game" Version="2026.1026.0" />
    <PackageReference Include="ppy.osu.Game.Rulesets.Osu" Version="2026.1026.0" />
  </ItemGroup>
</Project>
